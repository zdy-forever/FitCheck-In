# Copy to .env.local. These are PUBLIC values (safe in the browser).
# NEVER put the service-role / secret key in any VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Anon (legacy JWT) or publishable (sb_publishable_...) key
VITE_SUPABASE_ANON_KEY=
# Show the "Try the demo" entry point (requires DEMO_MODE_ENABLED=true on the demo-session function)
VITE_DEMO_MODE=true
