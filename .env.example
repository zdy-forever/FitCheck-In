# ── Web (web/.env.local) — PUBLIC values only ──────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=                 # anon (legacy JWT) or sb_publishable_... key
VITE_DEMO_MODE=true

# ── Edge Function secrets (supabase secrets set ...) — SERVER ONLY ─────────
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
DEMO_MODE_ENABLED=true                   # set to false to disable the public demo

# ── iOS (Config/FitCheckIn.local.xcconfig) — PUBLIC values only ────────────
# FITCHECKIN_SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
# FITCHECKIN_SUPABASE_ANON_KEY = sb_publishable_...
